APP_NAME="Kebapzade Premium"
APP_URL=
APP_TIMEZONE=Europe/Istanbul
APP_DEBUG=false

# Tek URL kullanmak isterseniz (mysql://user:pass@host:3306/db):
DATABASE_URL=
# veya ayrı alanlar:
DB_HOST=
DB_PORT=3306
DB_NAME=kebapzade_menu
DB_USER=
DB_PASS=
DB_SSL=false
DB_SSL_CA=
DB_SSL_VERIFY_SERVER_CERT=true
DB_TIMEOUT=5

SESSION_DRIVER=database
SESSION_TABLE=app_sessions
SESSION_LIFETIME=7200
SESSION_AUTO_MIGRATE=true
SESSION_SECURE_COOKIE=true

APP_STORAGE_DRIVER=vercel_blob
# Public Vercel Blob store bağlandığında bunlardan biri kullanılır:
BLOB_READ_WRITE_TOKEN=
# Yeni OIDC tabanlı Blob bağlantılarında Vercel otomatik sağlar:
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=

UPLOAD_MAX_BYTES=4194304

# install.php sadece bu token tanımlıyken açılır. Kurulumdan sonra env'i silin.
INSTALL_TOKEN=
